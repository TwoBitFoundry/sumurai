# ==============================================================================
# Sumurai Amazon Syncer Configuration
# ==============================================================================

# Gmail Account Configuration
# Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# IMAP Folder to inspect (default is INBOX; or "[Gmail]/All Mail" or custom label)
GMAIL_FOLDER=INBOX

# Sumurai PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:password@postgres:5432/accounting

# Local Ollama AI Endpoint
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# Sync Interval (in seconds, default 3600 = 1 hour)
SYNC_INTERVAL_SECONDS=3600

# Days to look back on initial scan
LOOKBACK_DAYS=30
