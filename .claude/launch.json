{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3001
    },
    {
      "name": "Storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "storybook"],
      "port": 6006
    },
    {
      "name": "Docker Compose (Full Stack)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose.dev.yml", "up", "-d", "--build"],
      "port": 8080
    }
  ]
}
