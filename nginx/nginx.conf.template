events {}

http {
    # Docker embedded DNS resolver for dynamic container discovery
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $http_x_forwarded_proto $real_scheme {
        default $scheme;
    }

    # Redirect HTTP to HTTPS but keep ACME HTTP-01 reachable
    server {
        listen 80;
        server_name ${DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location /healthz {
            add_header Content-Type text/plain;
            return 200 "ok";
        }

        location / {
            return 301 https://${DOMAIN}:${SSL_PORT}$request_uri;
        }
    }

    server {
        listen 443 ssl http2;
        server_name ${DOMAIN};

        ssl_certificate ${SSL_CERTIFICATE};
        ssl_certificate_key ${SSL_CERTIFICATE_KEY};
        ssl_session_timeout 1d;
        ssl_session_cache shared:MozSSL:10m;
        ssl_session_tickets off;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
        ssl_prefer_server_ciphers off;

        # Upstream service endpoints using variables to force dynamic DNS resolution
        set $frontend_upstream http://frontend:8080;
        set $backend_upstream http://backend:3000;
        set $seq_upstream http://seq:80;
        set $backend_docs http://backend:3000/scalar;

        # Basic proxy headers for upstream services
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $real_scheme;

        # Health probe for compose/k8s
        location = /healthz {
            add_header Content-Type text/plain;
            return 200 "ok";
        }

        # Backend health check (used by Uptime Kuma)
        location = /health {
            proxy_pass $backend_upstream;
        }

        # Public: Backend API docs only (Scalar UI)
        location = /docs {
            return 302 /docs/;
        }

        location /docs/ {
            proxy_pass $backend_docs;
        }

        # Public: Seq UI
        location = /seq {
            return 302 /seq/;
        }

        location /seq/ {
            rewrite ^/seq/?(.*)$ /$1 break;
            proxy_pass $seq_upstream;
        }

        # Public: OTLP HTTP ingestion -> Seq
        location /ingest/otlp {
            proxy_pass $seq_upstream;
            proxy_http_version 1.1;
            client_max_body_size 10m;
        }

        location /api {
            proxy_pass $backend_upstream;
        }

        location /_next/static/ {
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            proxy_pass $frontend_upstream;
        }

        # Default: frontend SPA
        location / {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            proxy_pass $frontend_upstream;
        }
    }
}
