{
  "name": "sumurai",
  "version": "5.2.7",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "prepare": "husky",
    "release": "semantic-release",
    "rust:lint": "cargo fmt --manifest-path backend/Cargo.toml --all --check && cargo clippy --manifest-path backend/Cargo.toml --locked --all-targets --no-deps -- -D warnings",
    "rust:typecheck": "cargo check --manifest-path backend/Cargo.toml --locked --all-targets",
    "rust:test": "cargo test --manifest-path backend/Cargo.toml --locked",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend test",
    "frontend:design": "npm --prefix frontend run design:guard",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:visual": "npm --prefix frontend run test:visual",
    "storybook": "npm --prefix frontend run storybook",
    "storybook:build": "npm --prefix frontend run storybook:build",
    "precommit": "npm run rust:typecheck && npm run rust:lint && npm run rust:test && npm run frontend:typecheck && npm run frontend:lint && npm run frontend:design && npm run frontend:test && npm run frontend:build"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3"
  }
}
