{
  "name": "sumurai",
  "version": "5.13.1",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "prepare": "husky",
    "rust:fmt": "cargo fmt --manifest-path backend/Cargo.toml --all --check",
    "rust:clippy": "cargo clippy --manifest-path backend/Cargo.toml --locked --all-targets --no-deps -- -D warnings",
    "rust:lint": "npm run rust:fmt && npm run rust:clippy",
    "rust:typecheck": "cargo check --manifest-path backend/Cargo.toml --locked --all-targets",
    "rust:test": "cargo test --manifest-path backend/Cargo.toml --locked",
    "rust:test:ci": "RUST_BACKTRACE=1 cargo test --manifest-path backend/Cargo.toml --locked",
    "backend:ci": "npm run rust:fmt && npm run rust:typecheck && npm run rust:clippy && npm run rust:test:ci",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend test",
    "frontend:design": "npm --prefix frontend run design:guard",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:storybook-runtime:run": "npm --prefix frontend run test:storybook-runtime:run",
    "frontend:storybook-test": "npm --prefix frontend run test:storybook",
    "frontend:playwright-install": "npm --prefix frontend run playwright:install",
    "frontend:ci": "npm --prefix frontend ci && npm --prefix frontend run lint && npm --prefix frontend run typecheck && npm --prefix frontend run design:guard && npm --prefix frontend run test:ci && npm --prefix frontend run build && npm --prefix frontend run playwright:install-ci && npm --prefix frontend run test:storybook && npm --prefix frontend run storybook:build && npm --prefix frontend run test:storybook-runtime:run",
    "test:storybook-runtime": "npm --prefix frontend run test:storybook-runtime",
    "storybook": "npm --prefix frontend run storybook",
    "storybook:build": "npm --prefix frontend run storybook:build",
    "precommit": "npm --prefix frontend run precommit && npm run backend:ci",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3"
  }
}
