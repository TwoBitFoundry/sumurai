{
  "name": "frontend",
  "version": "7.0.0",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "scripts": {
    "dev": "next dev -p 3001 --turbo",
    "dev:webpack": "next dev -p 3001 --webpack",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit --project tsconfig.ci.json",
    "start": "next start",
    "lint": "biome check --diagnostic-level=error .",
    "lint:verbose": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "jest --silent --maxWorkers=50%",
    "test:ci": "jest --ci --silent --maxWorkers=50%",
    "test:serial": "jest --runInBand --silent",
    "test:verbose": "jest --runInBand",
    "design:generate": "node ./scripts/generate-design-tokens.mjs",
    "design:drift": "node ./scripts/check-design-tokens-drift.mjs",
    "design:lint": "node ./scripts/run-designmd.mjs lint ../DESIGN.md",
    "design:export:dtcg": "node ./scripts/run-designmd.mjs export --format dtcg ../DESIGN.md",
    "design:export:tailwind": "node ./scripts/run-designmd.mjs export --format css-tailwind ../DESIGN.md",
    "design:spec": "node ./scripts/run-designmd.mjs spec --rules",
    "design:styling": "node ./scripts/check-raw-styling.mjs",
    "ui:imports": "node ./scripts/check-ui-imports.mjs",
    "design:guard": "node ./scripts/run-designmd.mjs --quiet lint ../DESIGN.md && node ./scripts/check-design-tokens-drift.mjs && node ./scripts/check-raw-styling.mjs && node ./scripts/check-text-color-styling.mjs && node ./scripts/check-ui-imports.mjs && node ./scripts/run-designmd.mjs --quiet export --format dtcg ../DESIGN.md && node ./scripts/run-designmd.mjs --quiet export --format css-tailwind ../DESIGN.md",
    "precommit": "npm run lint && npm run typecheck && npm run design:guard && npm run test",
    "storybook": "storybook dev -p 6006",
    "storybook:doctor": "storybook doctor",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "vitest --project=storybook run",
    "test:storybook:watch": "vitest --project=storybook",
    "playwright:install": "playwright install chromium",
    "playwright:install-ci": "playwright install chromium --with-deps",
    "test:storybook-runtime:run": "playwright test --config playwright.storybook-runtime.config.ts",
    "test:storybook-runtime": "npm run storybook:build && npm run test:storybook-runtime:run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/instrumentation": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "next": "^16.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plaid-link": "^4.1.1",
    "recharts": "^3.5.0",
    "serwist": "^9.5.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@google/design.md": "^0.1.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.5",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "^19.0.0-beta-df7b47d-20241124",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.10",
    "serve": "^14.2.6",
    "storybook": "^10.3.6",
    "style-dictionary": "^5.4.0",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "undici": "^7.24.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
