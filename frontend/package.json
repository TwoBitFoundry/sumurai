{
  "name": "frontend",
  "version": "7.3.4",
  "private": true,
  "engines": {
    "node": ">=24.10.0",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_PASSWORD_AUTH=true bun --bun next dev -p 3001 --turbo",
    "dev:webpack": "bun --bun next dev -p 3001 --webpack",
    "build": "bun --bun next build --webpack && bun ./scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.ci.json",
    "start": "bun --bun next start",
    "lint": "biome check --diagnostic-level=error .",
    "lint:verbose": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "bun test --parallel",
    "test:ci": "bun test --ci --parallel",
    "test:serial": "bun test --jobs 1",
    "test:verbose": "bun test --jobs 1 --verbose",
    "design:generate": "bun ./scripts/generate-design-tokens.mjs",
    "design:drift": "bun ./scripts/check-design-tokens-drift.mjs",
    "design:lint": "bun ./scripts/run-designmd.mjs lint ../DESIGN.md",
    "design:export:dtcg": "bun ./scripts/run-designmd.mjs export --format dtcg ../DESIGN.md",
    "design:export:tailwind": "bun ./scripts/run-designmd.mjs export --format css-tailwind ../DESIGN.md",
    "design:spec": "bun ./scripts/run-designmd.mjs spec --rules",
    "design:styling": "bun ./scripts/check-raw-styling.mjs",
    "ui:imports": "bun ./scripts/check-ui-imports.mjs",
    "design:guard": "bun ./scripts/run-designmd.mjs --quiet lint ../DESIGN.md && bun ./scripts/check-design-tokens-drift.mjs && bun ./scripts/check-raw-styling.mjs && bun ./scripts/check-text-color-styling.mjs && bun ./scripts/check-ui-imports.mjs && bun ./scripts/run-designmd.mjs --quiet export --format dtcg ../DESIGN.md && bun ./scripts/run-designmd.mjs --quiet export --format css-tailwind ../DESIGN.md",
    "precommit:verify": "sh -c 'bun run lint & lint_pid=$!; bun run typecheck & typecheck_pid=$!; lint_status=0; typecheck_status=0; wait \"$lint_pid\" || lint_status=$?; wait \"$typecheck_pid\" || typecheck_status=$?; [ \"$lint_status\" -eq 0 ] && [ \"$typecheck_status\" -eq 0 ]'",
    "precommit": "bun run precommit:verify && bun run design:guard && bun run test:ci && bun run build",
    "storybook": "storybook dev -p 6006",
    "storybook:doctor": "storybook doctor",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "vitest --project=storybook run",
    "test:storybook:watch": "vitest --project=storybook",
    "playwright:install": "playwright install chromium",
    "playwright:install-ci": "playwright install chromium --with-deps",
    "test:storybook-runtime:run": "playwright test --config playwright.storybook-runtime.config.ts",
    "test:storybook-runtime": "bun run storybook:build && bun run test:storybook-runtime:run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-web": "^0.66.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@paddle/paddle-js": "^1.6.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@google/design.md": "0.1.1",
    "@happy-dom/global-registrator": "20.11.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.4.3",
    "csstype": "^3.2.3",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "storybook": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
